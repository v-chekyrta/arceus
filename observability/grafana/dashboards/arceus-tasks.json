    {
      "id": 23,
      "type": "timeseries",
      "title": "Outcomes per day",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "refId": "task_published",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "MR opened",
          "queryType": "range",
          "expr": "sum(count_over_time({source=\"runner\", event=\"task_published\"}[1d]))"
        },
        {
          "refId": "task_failed",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "Failed",
          "queryType": "range",
          "expr": "sum(count_over_time({source=\"runner\", event=\"task_failed\"}[1d]))"
        },
        {
          "refId": "task_done",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "Done, no code change",
          "queryType": "range",
          "expr": "sum(count_over_time({source=\"runner\", event=\"task_done\"}[1d]))"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": null,
          "max": null,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 80,
            "barAlignment": 0,
            "pointSize": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0,
            "gradientMode": "none"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "MR opened"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
