    {
      "id": 24,
      "type": "table",
      "title": "Why tasks failed",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (count_over_time({source=\"runner\", event=\"task_failed\"} | json reason=\"reason\" [$__range]))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "format": "table",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "reason": "Reason",
              "Value #A": "Tasks",
              "Value": "Tasks"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "No failures in this period"
        },
        "overrides": []
      }
    },
    {
      "id": 25,
      "type": "logs",
      "title": "Task timeline",
      "description": "Every step the runner took for tickets, newest first.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 14,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{source=\"runner\", event=~\"task_.*|pushed|mr_ready|answer_sent|attempt_resumed|trigger_rejected|issue_skipped|notify_pending|reconcile_failed|review_.*|mr_state|branch_.*\"} | json | line_format \"{{.event}}{{with .task_id}}  {{.}}{{end}}{{with .stage}}  {{.}} · {{$.state}}{{else}}{{with .state}}  {{.}}{{end}}{{end}}{{with .author}}  by {{.}}{{end}}{{with .reason}}  — {{.}}{{end}}{{with .note}}  — {{.}}{{end}}{{with .summary}}  «{{.}}»{{end}}{{with .url}}  {{.}}{{end}}\"",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      }
    },
    {
      "id": 26,
      "type": "logs",
      "title": "Engine events",
      "description": "Bulava's own task stream: attempts started and ended, verdicts.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 14,
        "y": 13,
        "w": 10,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{source=\"bulava\"} | json | line_format \"{{.kind}}  {{.task_id}}  attempt {{.attempt}}  state {{.state}}{{with .disposition}}  verdict {{.}}{{end}}{{with .reason}}  — {{.}}{{end}}\"",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      }
    }
