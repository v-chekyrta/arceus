    {
      "id": 13,
      "type": "logs",
      "title": "Task progress",
      "description": "The running task step by step, newest first: what the runner did, each step of the engine, the agent's tool calls every minute (names and its own one-line descriptions, never commands), and Bulava's attempt stream.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{source=~\"runner|bulava\", event=~\"task_claimed|task_dispatched|task_published|task_failed|task_done|task_needs_input|workspace_.*|repo_cloned|engine_.*|agent_.*|attempt_.*|stalled_nudged|answer_sent|review_sent|dispatch_busy|send_busy|followup_waits|progress_unreadable|pushed|mr_ready|created|attempt-started|attempt-ended|stale-verdict\"} | json | line_format `{{if .kind}}engine {{.kind}}  {{.task_id}}  attempt {{.attempt}}{{with .disposition}}  verdict {{.}}{{end}}{{with .reason}}  — {{.}}{{end}}{{else if eq .event \"engine_step\"}}step  {{.task_id}}  {{.stage}} · {{.state}}{{with .note}}  — {{.}}{{end}}{{with .ms_taken}}  ({{.}} ms){{end}}{{else if eq .event \"agent_activity\"}}agent  {{.task_id}}  {{.tools}} tool calls, last {{.last_tool}}{{with .last_target}}: {{.}}{{end}}{{else if eq .event \"agent_quiet\"}}agent  {{.task_id}}  nothing written for {{.minutes}} min{{with .step}} (step {{.}}){{end}}{{else if eq .event \"engine_state\"}}engine  {{.task_id}}  {{.state}}, attempt {{.attempt}}{{if and (eq .state \"running\") (eq .attempt_live \"false\")}}, no live session{{end}}{{with .state_reason}}  — {{.}}{{end}}{{else if eq .event \"engine_call_started\"}}{{.call}}  {{.task_id}}  started{{else if eq .event \"engine_call_finished\"}}{{.call}}  {{.task_id}}  {{.result}} in {{.seconds}} s{{with .reason}}  — {{.}}{{end}}{{else}}{{.event}}{{with .task_id}}  {{.}}{{end}}{{with .repo}}  {{.}}{{end}}{{with .seconds}}  {{.}} s{{end}}{{with .reason}}  — {{.}}{{end}}{{with .url}}  {{.}}{{end}}{{end}}`",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      }
    },
    {
      "id": 14,
      "type": "table",
      "title": "Health checks",
      "description": "The runner's own checks and Bulava's doctor --server. Any Fail stops new work.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 10,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(runner_health)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "check": "Check",
              "Value": "Status"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "Nothing here"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OK",
                        "color": "#0ca30c",
                        "index": 0
                      },
                      "1": {
                        "text": "Warn",
                        "color": "#fab219",
                        "index": 1
                      },
                      "2": {
                        "text": "Fail",
                        "color": "#d03b3b",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
