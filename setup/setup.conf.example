# Settings for setup.sh. Copy to setup.conf next to setup.sh.

# Everything (runner, Bulava, claude, codex, tmux, git, the project's Docker stack) runs as the user
# who owns this folder and runs `sudo ./setup.sh` from it; there is nothing to set. Setup creates no
# users and changes nobody's sudo. The isolation boundary is the VM: the workers run as this user
# and can read the runner's tokens.

# Pinned tool versions. Change them here, re-run setup: the old version is replaced.
CLAUDE_CODE_VERSION=2.1.322
CODEX_VERSION=0.167.2
CHROME_DEVTOOLS_MCP_VERSION=1.10.1   # must match Bulava's engine/supervisor/automation-mcp.json
# Google Sheets, Docs and Drive for the agent, read-only (README, "Google documents"). Empty: no Google.
WORKSPACE_MCP_VERSION=2.3.0

# Bulava engine (engine/SERVER.md), installed to /opt/bulava. Empty BULAVA_SOURCE skips it.
# BULAVA_REF: a full commit (Bulava rewrites its branches; setup keeps every installed commit in
# /var/lib/arceus/bulava.git), or a branch to follow. To update: `git ls-remote <source> refs/heads/main`,
# check engine/SERVER.md, re-run setup between tasks (it refuses while a task is running).
BULAVA_SOURCE=https://github.com/Stepanokdev/bulava
BULAVA_REF=331f7f560b1ba8fe0d38c94071f7cd6928489848   # main, 1.19.2 (2026-11-12)
