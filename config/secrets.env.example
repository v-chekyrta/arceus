# Runner tokens. Copy to ~/arceus/data/secrets.env (setup does it once), chmod 600.
# The runner reads this file itself; it is not loaded into any process environment.
# Each name is the token_env of a section in config.yaml; these are the defaults of the YouTrack
# tracker and the GitLab code host. SLACK_BOT_TOKEN only if config.yaml has a slack section.
YOUTRACK_TOKEN=perm:replace-me
GITLAB_TOKEN=glpat-replace-me
SLACK_BOT_TOKEN=xoxb-replace-me
# Only with code_host.approver in config.yaml: the approver account's token (scope api).
# GITLAB_REVIEW_TOKEN=glpat-replace-me
