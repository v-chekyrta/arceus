# Optional, and normally left as it is. Environment for the Bulava engine only.
#
# Claude and Codex are signed in the usual way, as the user the runner runs as:
#   claude  ->  /login            (~/.claude/.credentials.json, refreshed by Claude)
#   codex login --device-auth     (~/.codex/auth.json)
#
# Do not put a `claude setup-token` token here. It overrides /login, and it cannot read the
# subscription usage meter (403, scope user:profile): the engine then cannot see when a limit
# resets. setup links this file to ~/.config/claude/oauth.env only on a machine with no /login.
#CLAUDE_CODE_OAUTH_TOKEN=
#CLAUDE_CODE_OAUTH_TOKEN_ISSUED_AT=
